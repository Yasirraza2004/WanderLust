<% layout("/layouts/boilerplate") %>

    <div class="container-fluid px-4">
        <div class="category-wrapper">

            <button class="scroll-btn left" id="scrollLeft">
                <i class="fa-solid fa-chevron-left"></i>
            </button>

            <div class="categories" id="categories">

                <a href="/listings">
                    <div class="icons"><i class="fa-solid fa-house"></i></div>
                    <span>All</span>
                </a>

                <a href="/listings?category=Homes">
                    <div class="icons"><i class="fa-solid fa-fire"></i></div>
                    <span>Trending</span>
                </a>

                <a href="/listings?category=Mountains">
                    <div class="icons"><i class="fa-solid fa-mountain"></i></div>
                    <span>Mountains</span>
                </a>

                <a href="/listings?category=Farms">
                    <div class="icons"><i class="fa-solid fa-cow"></i></div>
                    <span>Farms</span>
                </a>

                <a href="/listings?category=Cities">
                    <div class="icons"><i class="fa-solid fa-city"></i></div>
                    <span>Iconic Cities</span>
                </a>

                <a href="/listings?category=Amazing pools">
                    <div class="icons"><i class="fa-solid fa-water-ladder"></i></div>
                    <span>Amazing Pools</span>
                </a>

                <a href="/listings?category=Beach">
                    <div class="icons"><i class="fa-solid fa-umbrella-beach"></i></div>
                    <span>Beach</span>
                </a>

            </div>

            <button class="scroll-btn right" id="scrollRight">
                <i class="fa-solid fa-chevron-right"></i>
            </button>

            <div class="tax-toggle">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault">
                        Display total after taxes
                    </label>
                </div>
            </div>

        </div>
    </div>

    <div class="container mt-4">

        <div class="listings-grid">

            <% for(let listing of allListings) { %>

                <a href="/listings/<%= listing._id %>" class="listing-link">

                    <div class="card listing-card">

                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">

                        <div class="card-img-overlay"></div>

                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%= listing.title %>
                                </b><br>

                                &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
                                
                                    <i class="tax-info">
                                        &nbsp;&nbsp;+18% GST
                                    </i>
                            </p>
                        </div>

                    </div>

                </a>

                <% } %>

        </div>

    </div>
                
