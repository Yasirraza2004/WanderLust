<% layout("/layouts/boilerplate") %>

<div class="container mt-3">
    <!-- Categories -->
    <div class="categories">
        <a href="/listings">
            <div class="icons"><i class="fa-solid fa-house"></i></div>
             <span>All</span>
        </a>

        <a href="/listings?category=Homes">
            <div class="icons"><i class="fa-solid fa-fire"></i></div>
             <span>Trending</span>
        </a>

        <a href="/listings?category=Mountains">
            <div class="icons"><i class="fa-solid fa-mountain"></i></div>
             <span>Mountains</span>
        </a>

        <a href="/listings?category=Farms">
            <div class="icons"><i class="fa-solid fa-city"></i></div>
             <span>Farms</span>
        </a>

        <a href="/listings?category=cities">
            <div class="icons"><i class="fa-solid fa-city"></i></div>
             <span>Iconic cities</span>
        </a>

        <a href="/listings?category=Amazing pools">
            <div class="icons"><i class="fa-solid fa-water-ladder"></i></div>
             <span>Amazing pools</span>
        </a>

        <a href="/listings?category=Beach">
            <div class="icons"><i class="fa-solid fa-umbrella-beach"></i></div>
             <span>Beach</span>
        </a>

        <div class="tax-toggle">
                <div class="form-check-reverse form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
                </div>
            </div>
    </div>
</div>


    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1" mt-3>
        <% for(let listing of allListings) { %>
            <a href="/listings/<%= listing._id%>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b>
                                <%= listing.title %>
                            </b> <br>
                            &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
                                <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
            <% } %>
    <script src="/js/script.js"></script>
